# --- Frontend ---

# Prazno = same-origin (Vite proxy u dev-u, reverse proxy u produkciji).
# Postavi pun URL backend-a samo ako frontend i backend nisu iza istog domena.
VITE_API_BASE_URL=

# --- Backend (cmd/rpcapi) ---

DATABASE_URL=postgres://postgres@localhost:5434/mreza_anketa_dev?sslmode=disable
HTTP_ADDR=:8080

# Postuj X-Forwarded-For / X-Real-IP pri odredjivanju IP-a klijenta za rate limit.
# "true" SAMO kad je backend iza reverse proxy-ja (Caddy/Nginx) koji te headere
# prepisuje. Ako je backend direktno izlozen, ostavi prazno — inace svako moze
# da zaobidje rate limit izmisljenim headerom.
TRUST_PROXY_HEADERS=

# --- Google OAuth (admin login) — OPCIONO ---
# Ostavi sva tri prazna ako ne zelis Google OAuth (admini onda mogu samo password login).
# Ako se postavi CLIENT_ID, mora i SECRET i CALLBACK_URL.
# CALLBACK_URL ide na frontend port (5173) jer Vite proxy prosledjuje na backend —
# isti origin znaci da SameSite=Lax cookie radi.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5173/auth/google/callback

# --- Session ---
# 32+ bajta. Generisi sa: openssl rand -base64 32
SESSION_SECRET=base64:CHANGE_ME_32_BYTES_BASE64

# --- Admin bootstrap ---
# Comma-separated, lowercase. Kreiraju se na startu ako ne postoje (idempotentno).
INITIAL_ADMIN_EMAILS=admin@example.com

# Inicijalna lozinka za sve gornje email-ove (min 8 chars). OVERWRITE-uje postojeci hash
# pri svakom startu — promeni lozinku iz UI posle prvog logina i OBRISI ovu vrednost.
INITIAL_ADMIN_PASSWORD=

# Public frontend URL (koristi se za OAuth redirect nazad posle logina).
PUBLIC_BASE_URL=http://localhost:5173

# dev ili prod — kontrolise Secure flag na session cookie-ju.
APP_ENV=dev
