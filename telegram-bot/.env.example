# --- Obavezno ---

# Token koji ti da @BotFather.
BOT_TOKEN=

# Telegram ID-evi ljudi koji smeju admin komande, razdvojeni zarezom.
# Svoj ID saznaj tako sto botu @userinfobot posaljes bilo sta.
ADMIN_IDS=123456789

# --- Preporuceno ---

# Grupa u koju stizu zahtevi za ulazak u KREATORI/VLASNICI, sa dugmadima
# Odobri/Odbij. Bez ovoga se zahtevi ne mogu odobravati iz bota.
ADMIN_GROUP_ID=

# Link na politiku privatnosti sa sajta; prikazuje se uz pristanak.
PRIVACY_URL=

# --- Kanali i grupe ---
# Nepopunjeno = bot taj kanal preskace. Mozes krenuti sa tri i dodavati ostale.
# ID kanala se dobija tako sto proslediš poruku iz kanala botu @userinfobot.
# Uvek pocinje sa -100.

CHANNEL_TEME=
CHANNEL_FB=
CHANNEL_IG=
CHANNEL_TIKTOK=
CHANNEL_X=
CHANNEL_TG=
CHANNEL_USMENA=

# Grupe sa rucnim odobravanjem ulaska.
GROUP_KREATORI=
GROUP_VLASNICI=

# --- Ostalo ---

DB_PATH=./bot.db
LOG_PATH=./bot.log

# Koliko sati vazi jednokratna pozivnica.
INVITE_TTL_HOURS=2
